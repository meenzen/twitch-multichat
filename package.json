{
  "name": "twitch-multichat",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun test --conditions=browser",
    "test:e2e": "bun --config=e2e/bunfig.toml test ./e2e",
    "lint": "eslint . --ext .js,.ts,.svelte",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.0",
    "@eslint/js": "^10.0.0",
    "@ethercorps/sveltekit-og": "^4.2.1",
    "@fontsource/inter": "^5.2.8",
    "@happy-dom/global-registrator": "^21.0.3",
    "@lucide/svelte": "^1.59.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/svelte": "^5.4.2",
    "@twurple/auth": "^8.1.3",
    "@twurple/chat": "^8.1.3",
    "@types/bun": "^1.4.3",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "espree": "^11.2.0",
    "fast-glob": "^3.3.3",
    "globals": "^17.5.0",
    "linkifyjs": "^4.3.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.0",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "patchedDependencies": {
    "ultrahtml@1.7.0": "patches/ultrahtml@1.7.0.patch"
  }
}
