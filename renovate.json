{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "groupName": "nix flake inputs",
      "matchManagers": ["nix"]
    },
    {
      "description": "Pinned to the commit of nix-community/bun2nix#110 until a release includes it, see flake.nix",
      "matchManagers": ["nix"],
      "matchDepNames": ["bun2nix"],
      "enabled": false
    },
    {
      "description": "Flake inputs get their own PR, keep flake.lock out of the bun.lock maintenance",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    },
    {
      "groupName": "svelte",
      "matchPackageNames": ["@sveltejs/**", "svelte", "svelte-check"]
    },
    {
      "groupName": "eslint and prettier",
      "matchPackageNames": [
        "@babel/eslint-parser",
        "@eslint/js",
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-svelte",
        "espree",
        "globals",
        "prettier",
        "prettier-plugin-svelte",
        "typescript-eslint"
      ]
    },
    {
      "groupName": "vite and plugins",
      "matchPackageNames": ["@sveltejs/vite-plugin-svelte", "vite"]
    }
  ]
}
